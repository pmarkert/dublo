{
  "manifest_version": 3,
  "name": "Dublo Observation",
  "version": "0.1.0",
  "description": "Capture a Dublo-style observation of the current page.",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/dublo-16.png",
    "32": "icons/dublo-32.png",
    "48": "icons/dublo-48.png",
    "128": "icons/dublo-128.png"
  },
  "action": {
    "default_title": "Capture Dublo observation",
    "default_icon": {
      "16": "icons/dublo-16.png",
      "32": "icons/dublo-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}